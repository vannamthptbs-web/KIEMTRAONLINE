rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "vannamthptbs@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Question Sets (Bộ câu hỏi 1, 2, 3...)
    match /question_sets/{id} {
      allow read, write: if true;
    }

    // Questions: Anyone can read, teachers and admins can manage
    match /questions_mcq/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /questions_tf/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /questions_sa/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Users (Admin, Teachers)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Teachers
    match /teachers/{id} {
      allow read, write: if true;
    }

    // Classes
    match /classes/{id} {
      allow read, write: if true;
    }

    // Students
    match /students/{id} {
      allow read, write: if true;
    }

    // Quiz Results
    match /quiz_results/{id} {
      allow read, write: if true;
    }

    // Settings (Google Sheet links, system configs)
    match /settings/{id} {
      allow read, write: if true;
    }
  }
}
